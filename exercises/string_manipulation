nome_completo = input("Digite seu nome completo:")   #Recebe o nome do usuário
primeiro_nome = nome_completo.split()[0]

print(f"Seu nome com letras Maiúsculas: {nome_completo.upper()}")  #Transforma o nome em letras maiúsculas.
print(f"Seu nome com letras Minúsculas: {nome_completo.lower()}")  #Transforma o nome em letras minúsculas.
print(f"Número de letras do seu nome:  {len(nome_completo.replace(" ", ""))}") #Conta as letras do nome eliminando os espaços.
print(f"Quantas letras tem o primeiro nome: {len(primeiro_nome)}") #Conta as letras do primeiro nome.
