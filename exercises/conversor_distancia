conversor_distancia = float(input("Olá! Digite uma distância em metros: "))
print(f"A medida de {conversor_distancia} corresponde a: ")

distancia_kms = conversor_distancia / 1000
distancia_hm = conversor_distancia / 100
distancia_dam = conversor_distancia / 10
distancia_dm = conversor_distancia * 10
distancia_cm = conversor_distancia * 100
distancia_mm = conversor_distancia * 1000

print(f"{distancia_kms}km")
print(f"{distancia_hm}hm")
print(f"{distancia_dam}dam")
print(f"{distancia_dm}dm")
print(f"{distancia_cm}cm")
print(f"{distancia_mm}mm")
